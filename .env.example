# CVForge monetization configuration
#
# These are Vite BUILD-TIME variables — they are baked into the static
# bundle when you run `npm run build`. They are NOT runtime secrets and
# everything set here is publicly visible in the shipped JavaScript.
#
# NEVER put private payment credentials (secret API keys, webhook signing
# secrets, etc.) in any VITE_* variable. Public/publishable identifiers and
# checkout LINKS are fine; secret keys must live only on your payment
# provider's dashboard or a server you operate.

# Real checkout URL for the Premium upgrade buttons.
# Create a product and a checkout/payment link in your payment provider
# (e.g. Stripe Payment Link, Lemon Squeezy, Paddle), then set this to the
# link your provider gives you. Leave unset until you have a real link —
# the app then shows an honest "checkout not yet configured" notice
# instead of sending users anywhere.
VITE_UPGRADE_URL=

# One-time Premium price and ISO 4217 currency shown in the UI.
VITE_PREMIUM_PRICE=9.99
VITE_PREMIUM_CURRENCY=USD

# DEVELOPMENT/QA ONLY — never set this for production builds.
# When "true", the app exposes the internal test checkout page at
# #/checkout, which flips the local Free/Premium entitlement flag in the
# browser. No payment is processed, simulated, or claimed. This is NOT a
# real customer payment flow.
# VITE_ENABLE_TEST_MODE=true
